      "light_mode": {"name": "Light", "state": {"off": "Off", "low": "Low", "medium": "Medium", "high": "High", "sos": "SOS"}},
      "clock_first_brightness": {"name": "First clock window brightness", "state": {"normal": "Normal", "high": "High"}},
      "clock_second_brightness": {"name": "Second clock window brightness", "state": {"normal": "Normal", "high": "High"}}
